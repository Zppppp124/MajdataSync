<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);live-test*/**;majdata-settings-source/**;majdata-raw-source/**;majdata-extra-source/**</DefaultItemExcludes>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MajdataSync</AssemblyName>
    <RootNamespace>MajdataSync</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.8.2</Version>
    <FileVersion>1.8.2.0</FileVersion>
    <Product>Majdata Sync</Product>
    <Company>Majdata Sync</Company>
    <RepositoryUrl>https://github.com/Zppppp124/MajdataSync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app.ico" />
    <Compile Remove="MajdataSync.Tests\**\*.cs" />
    <None Remove="MajdataSync.Tests\**\*" />
    <Content Remove="MajdataSync.Tests\**\*" />
  </ItemGroup>
</Project>
